Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fit", "=", 
   RowBox[{"FindFit", "[", 
    RowBox[{"degreeDistribution", ",", 
     RowBox[{"a", "*", 
      RowBox[{"x", "^", 
       RowBox[{"(", 
        RowBox[{"-", "gamma"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "gamma"}], "}"}], ",", "x"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"powerLawExponent", "=", 
   RowBox[{"gamma", "/.", " ", "fit"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogLogPlot", "[", "degreeDistribution", "]"}], ",", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "*", 
       RowBox[{"x", "^", 
        RowBox[{"(", 
         RowBox[{"-", "gamma"}], ")"}]}]}], "/.", " ", "fit"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"Min", "[", 
        RowBox[{"degreeDistribution", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"degreeDistribution", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
   ",", 
   RowBox[{"PlotLabel", "->", "\"\<Power-Law Fit\>\""}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Weighted Degree (k)\>\"", ",", "\"\<P(k)\>\""}], "}"}]}], 
   ",", 
